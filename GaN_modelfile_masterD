#########################################################################################
#constants for each material
#########################################################################################

set k 1.38066e-23
set q 1.60218e-19
set Vt ($k*Temp/$q)
set eps0 8.854e-14
set kev 8.617e-5
set VtRoom [expr $k*300.0/$q]
set hbar 1.054571628e-34
set egan 7.88e-13

# electron mobility model: static (constant) or field (doping/temperature/field dependent)
if {![info exists mobModel]} { set mobModel static }

source GaN.tcl
source AlGaN.tcl
source Insulator.tcl
source Metal.tcl


#thermal domain
solution add name=Temp const val=300.0

#electrical domain

solution add name=DevPsi solve negative damp continuous
solution add name=Qfp solve negative damp continuous
solution add name=Qfn solve negative damp continuous



source Continuity.tcl
ElecContinuity GaN
ElecContinuity AlGaN

HoleContinuity GaN
HoleContinuity AlGaN

# Is the interface charge constant everwhere all the time?
#Add interface charge
pdbSetString AlGaN_GaN DevPsi Equation "7.0e12"

source Poisson.tcl
Poisson AlGaN
Poisson GaN
InsPoisson Metal
InsPoisson Nitride
InsPoisson HighK

# Trap levers: any of these can be set by the driver script before sourcing
# this file to override the defaults.
if {![info exists trapEn]}    { set trapEn 0.0 }
if {![info exists trapPeak]}  { set trapPeak 4e18 }   ;# peak trap density (cm^-3)
if {![info exists trapMeanX]} { set trapMeanX 0.0 }   ;# Gaussian center, depth (um)
if {![info exists trapMeanY]} { set trapMeanY 0.20 }  ;# Gaussian center, lateral (um)
if {![info exists trapSigma]} { set trapSigma 0.025 } ;# Gaussian spatial sigma (um)
if {![info exists trapLevel]} { set trapLevel 0.68 }  ;# trap depth below Ec (eV)
if {![info exists trapWidth]} { set trapWidth 0.1 }   ;# energy FWHM (eV)

# 2D Gaussian trap distribution
set sigma $trapSigma
set mean_x $trapMeanX
set mean_y $trapMeanY
set trapConc "$trapPeak*exp(-((x-$mean_x)*(x-$mean_x)+(y-$mean_y)*(y-$mean_y))/(2.0*$sigma*$sigma))"

# Hot-electron trap capture (see IonizedAcceptor / HotStress in Poisson.tcl)
if {![info exists hotEb]}   { set hotEb 0.3 }       ;# capture barrier (eV); 0 = Fermi-level occupancy
if {![info exists hotTau]}  { set hotTau 1.0e-13 }  ;# energy relaxation time (s)
if {![info exists hotMu]}   { set hotMu 600.0 }     ;# GaN electron mobility (cm2/Vs), matches GaN.tcl
if {![info exists hotVsat]} { set hotVsat 1.9e7 }   ;# saturation velocity (cm/s)

if {$trapEn} {
    IonizedAcceptor GaN $trapConc $trapLevel $trapWidth
    IonizedAcceptor AlGaN $trapConc $trapLevel $trapWidth
}

#Electrical Initial Conditions
proc Initialize {} {
    sel z=300.00 name=Temp
    solution name=Qfn val=0 const
    solution name=Qfp val=0 const

    # charge-neutral initial potential in GaN, then AlGaN
    newton GaN eqn=Doping-Elec+Hole var=DevPsi damp=0.025
    newton AlGaN eqn=Doping-Elec+Hole var=DevPsi damp=0.025
    
    #now Metal
    InitMetal

    # trap freeze fields: must not be spatially constant, or FLOOXS folds them
    # into the equations as fixed numbers at device init (see FreezeTraps)
    sel z=1.0e-30*(1.0+x*x) name=TrapFrozen
    sel z=1.0e-30*(1.0+x*x) name=FrozenFlag
    sel z=Temp+1.0e-12*(1.0+x*x) name=TeTrap
    sel z=0.0 name=Qfn
    sel z=0.0 name=Qfp

    device init
    solution add name=Qfp solve negative damp continuous pde
    solution add name=Qfn solve negative damp continuous pde
}
