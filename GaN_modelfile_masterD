#########################################################################################
#constants for each material
#########################################################################################

set k 1.38066e-23
set q 1.60218e-19
set Vt ($k*Temp/$q)
set eps0 8.854e-14
set kev 8.617e-5
set VtRoom [expr $k*300.0/$q]
set hbar 1.054571628e-34
set egan 7.88e-13

# electron mobility model: static (constant) or field (doping/temperature/field dependent)
if {![info exists mobModel]} { set mobModel static }

source GaN.tcl
source AlGaN.tcl
source Insulator.tcl
source Metal.tcl


#thermal domain
solution add name=Temp const val=300.0

#electrical domain

solution add name=DevPsi solve negative damp continuous
solution add name=Qfp solve negative damp continuous
solution add name=Qfn solve negative damp continuous



source Continuity.tcl
ElecContinuity GaN
ElecContinuity AlGaN

HoleContinuity GaN
HoleContinuity AlGaN

# Is the interface charge constant everwhere all the time?
#Add interface charge
if {![info exists polCharge]} { set polCharge 7.0e12 } ;# net AlGaN/GaN interface (polarization) charge, cm^-2
pdbSetString AlGaN_GaN DevPsi Equation "$polCharge"
# Optional net fixed charge at the AlGaN/SiN surface (cm^-2): surface donors in
# excess of the AlGaN surface polarization charge (passivation-induced). Unset = none.
if {[info exists surfCharge]} { pdbSetString AlGaN_Nitride DevPsi Equation "$surfCharge" }

source Poisson.tcl
Poisson AlGaN
Poisson GaN
InsPoisson Metal
InsPoisson Nitride
InsPoisson HighK

# Trap levers: any of these can be set by the driver script before sourcing
# this file to override the defaults.
if {![info exists trapEn]}    { set trapEn 0.0 }
if {![info exists trapPeak]}  { set trapPeak 4e18 }   ;# peak trap density (cm^-3)
if {![info exists trapMeanX]} { set trapMeanX 0.0 }   ;# Gaussian center, depth (um)
if {![info exists trapMeanY]} { set trapMeanY 0.20 }  ;# Gaussian center, lateral (um)
if {![info exists trapSigma]} { set trapSigma 0.025 } ;# Gaussian spatial sigma (um)
;# trapSigmaY (optional, no default): lateral sigma; if set, trapSigma is the depth sigma only
if {![info exists trapLevel]} { set trapLevel 0.68 }  ;# trap depth below Ec (eV)
if {![info exists trapWidth]} { set trapWidth 0.1 }   ;# energy FWHM (eV)

# Trap spatial distribution. trapShape picks the profile; each shape is a
# proc TrapConc_<shape> returning a FLOOXS expression in x (depth, um) and
# y (lateral, um). Add new shapes (e.g. an imported TRIM profile) the same way.
#   gauss - 2D Gaussian centred at (trapMeanX, trapMeanY), sigma trapSigma
#   cone  - displacement-cascade-like cone: apex at (trapMeanX, trapMeanY),
#           axis along +x (into the device), half-width coneW0 at the apex
#           widening at half-angle coneAngle over depth coneLen; uniform
#           density trapPeak inside, erf-softened edges of width coneEdge
if {![info exists trapShape]} { set trapShape gauss }
if {![info exists coneLen]}   { set coneLen 0.1 }    ;# cone depth extent from apex (um)
if {![info exists coneAngle]} { set coneAngle 30.0 } ;# cone half-angle (deg)
if {![info exists coneW0]}    { set coneW0 0.01 }    ;# cone half-width at the apex (um)
if {![info exists coneEdge]}  { set coneEdge 0.01 }  ;# edge softness (um); mesh is ~5-50 nm

proc TrapConc_gauss {} {
    global trapPeak trapMeanX trapMeanY trapSigma trapSigmaY
    set s $trapSigma
    if {![info exists trapSigmaY]} {
        return "$trapPeak*exp(-((x-($trapMeanX))*(x-($trapMeanX))+(y-($trapMeanY))*(y-($trapMeanY)))/(2.0*$s*$s))"
    }
    # anisotropic: trapSigma in depth (x), trapSigmaY laterally (y)
    set sy $trapSigmaY
    return "$trapPeak*exp(-(x-($trapMeanX))*(x-($trapMeanX))/(2.0*$s*$s)-(y-($trapMeanY))*(y-($trapMeanY))/(2.0*$sy*$sy))"
}

proc TrapConc_cone {} {
    global trapPeak trapMeanX trapMeanY coneLen coneAngle coneW0 coneEdge
    set tanA [expr {tan($coneAngle * acos(-1.0) / 180.0)}]
    set e $coneEdge
    set x0 $trapMeanX
    # local half-width grows linearly with depth below the apex
    set w "($coneW0+$tanA*(x-($x0)))"
    # smooth steps: inside the half-width laterally, between apex and apex+coneLen
    # axially (the apex-side step is shifted by 2e so the apex itself is full)
    set lat "0.5*(1.0+erf(($w-abs(y-($trapMeanY)))/$e))"
    set top "0.5*(1.0+erf((x-($x0)+2.0*$e)/$e))"
    set bot "0.5*(1.0+erf((($x0)+$coneLen-x)/$e))"
    return "$trapPeak*$lat*$top*$bot"
}

if {[info procs TrapConc_$trapShape] eq ""} {
    error "unknown trapShape '$trapShape' (no proc TrapConc_$trapShape)"
}
set trapConc [TrapConc_$trapShape]

# Hot-electron trap capture (see IonizedAcceptor / HotStress in Poisson.tcl)
if {![info exists hotEb]}   { set hotEb 0.3 }       ;# capture barrier (eV); 0 = Fermi-level occupancy
if {![info exists hotTau]}  { set hotTau 1.0e-13 }  ;# energy relaxation time (s)
if {![info exists hotMu]}   { set hotMu 600.0 }     ;# GaN electron mobility (cm2/Vs), matches GaN.tcl
if {![info exists hotVsat]} { set hotVsat 1.9e7 }   ;# saturation velocity (cm/s)

# Traps in the insulators (Nitride, HighK): static charge only, since no
# carriers or Qfn are solved there. 0 = none (default, unchanged behavior);
# -1 = the same trap density fully filled (-q*N); +1 = fixed positive (+q*N).
if {![info exists insTrapSign]} { set insTrapSign 0 }

if {$trapEn} {
    IonizedAcceptor GaN $trapConc $trapLevel $trapWidth
    IonizedAcceptor AlGaN $trapConc $trapLevel $trapWidth
    if {$insTrapSign != 0} {
        InsTrapCharge Nitride $trapConc $insTrapSign
        InsTrapCharge HighK $trapConc $insTrapSign
    }
}

#Electrical Initial Conditions
proc Initialize {} {
    sel z=300.00 name=Temp
    solution name=Qfn val=0 const
    solution name=Qfp val=0 const

    # charge-neutral initial potential in GaN, then AlGaN
    newton GaN eqn=Doping-Elec+Hole var=DevPsi damp=0.025
    newton AlGaN eqn=Doping-Elec+Hole var=DevPsi damp=0.025
    
    #now Metal
    InitMetal

    # trap freeze fields: must not be spatially constant, or FLOOXS folds them
    # into the equations as fixed numbers at device init (see FreezeTraps)
    sel z=1.0e-30*(1.0+x*x) name=TrapFrozen
    sel z=1.0e-30*(1.0+x*x) name=FrozenFlag
    sel z=Temp+1.0e-12*(1.0+x*x) name=TeTrap
    sel z=0.0 name=Qfn
    sel z=0.0 name=Qfp

    device init
    solution add name=Qfp solve negative damp continuous pde
    solution add name=Qfn solve negative damp continuous pde
}
