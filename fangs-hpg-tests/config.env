# Settings shared by every script in fangs-hpg-tests/ (sourced on the workstation and on HPG).
# Change COMMIT only when Ian says so (a newer pushed flooxs-pyplot commit). Everything on HPG lives under BASE, so the
# cleanup is one directory.

COMMIT=92b55cee                      # flooxs-pyplot commit to test (rerun 2026-10-15: capped.sh under SLURM, goldens, erfc, TDR fixes; run 1 was 28d8af2b)
TAG=20261015                         # date tag of this test campaign (results folder names)

# workstation
WS_REPO=/home/staffian/flooxs-pyplot                      # flooxs-pyplot working copy (read only for this campaign)
WS_BUNDLE=/home/staffian/fangs-hpg-$TAG.bundle            # git bundle made by make_bundle.sh, deleted by cleanup.sh
WS_RESULTS=$WS_REPO/Test/Regression/hpg_results/$TAG-fangs   # where fetch_results.sh puts everything (gitignored there)

# HiPerGator
HPG_USER_BLUE=/home/ianstafford/blue/ee1/ianstafford
BASE=$HPG_USER_BLUE/fangs-hpg-$TAG   # the only directory this campaign creates on HPG
ENV=$BASE/env                        # conda environment (compilers, libraries, Python, Tcl)
PKGS=$BASE/conda-pkgs                # conda package cache (kept out of ~ and out of ~/.condarc)
FLX=$BASE/flooxs-pyplot              # checkout of COMMIT, built in build/ (Tcl-free) and build-tcl/ (Tcl reference)
RUN=$BASE/results                    # tcl/ py/ tcl-dag/ tcl-thr4v/ run directories, compare/, logs/

# SLURM (HEMTRAD CLAUDE.md section 2: ask Ian before every sbatch)
ACCOUNT=ee1
QOS=ee1-b                            # burst QOS (about 171 CPUs for the group); ee1 is 19 CPUs
PARTITION=hpg-milan                  # same node type as the 2026-10-08 baselines (EPYC 75F3), so timings compare
CPUS=16                              # per test task, as on 2026-10-08 (16-core slice, threads capped at 16)
